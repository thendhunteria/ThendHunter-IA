rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || 
        request.auth.token.email == 'gustavocesarlopezornelas@gmail.com'
      );
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid || 
        request.auth.token.email == 'gustavocesarlopezornelas@gmail.com'
      );
      allow delete: if request.auth != null && request.auth.token.email == 'gustavocesarlopezornelas@gmail.com';
    }
    match /analytics/global {
      allow read: if true;
      allow write: if true;
    }
  }
}
